{
 "$schema":"node_modules/wrangler/config-schema.json",
 "name":"copa-integracion",
 "main":"worker.ts",
 "compatibility_date":"2026-10-01",
 "assets":{"directory":"./public","binding":"ASSETS"},
 "d1_databases":[{"binding":"DB","database_name":"copa-integracion-db","migrations_dir":"drizzle"}],
 "r2_buckets":[{"binding":"BUCKET","bucket_name":"copa-integracion-fotos"}]
}
